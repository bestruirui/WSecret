{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wsecret",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-25",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wsecret",
			"database_id": "a70cd7b7-f418-4544-9949-c38da1e3425e",
			"remote": false
		}
	],
}